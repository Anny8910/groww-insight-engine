# Copy to .env.local and fill in real values. Never commit .env.local.

# Groq (OpenAI-compatible) — used for theme clustering and drafting.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Secret used to sign one-time approval tokens for the MCP write tools.
APPROVAL_SECRET=change_me_to_a_long_random_string

# Reviews CSV consumed by the Review Intelligence Layer.
REVIEWS_CSV=data/reviews.csv
